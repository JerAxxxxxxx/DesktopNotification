{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "下班啦",
  "mainBinaryName": "offwork",
  "version": "0.4.3",
  "identifier": "com.hugo.offwork",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "下班啦 · 提醒设置",
        "width": 820,
        "height": 670,
        "minWidth": 720,
        "minHeight": 580,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "shortDescription": "工作有时，生活也是。一个安静的下班提醒工具。",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
